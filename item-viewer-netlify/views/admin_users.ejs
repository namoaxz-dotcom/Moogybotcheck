<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>จัดการผู้ใช้งาน</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container mt-5" style="max-width: 800px;">
    <div class="card shadow mb-4">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0">เพิ่มผู้ใช้งานใหม่</h5>
        <a href="/items" class="btn btn-sm btn-secondary">ย้อนกลับ</a>
      </div>
      <div class="card-body">
        <% if (message) { %>
          <div class="alert alert-danger py-2"><%= message %></div>
        <% } %>
        <form action="/admin/users/add" method="POST" class="row g-3">
          <div class="col-md-4">
            <input type="text" name="username" class="form-control" placeholder="Username" required>
          </div>
          <div class="col-md-4">
            <input type="password" name="password" class="form-control" placeholder="Password" required>
          </div>
          <div class="col-md-2">
            <select name="role" class="form-select">
              <option value="user">User</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">เพิ่ม</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow">
      <div class="card-body">
        <h5 class="card-title mb-3">รายชื่อผู้ใช้งานในระบบ</h5>
        <table class="table table-bordered">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Role</th>
              <th>การจัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.username %></td>
                <td><span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'secondary' %>"><%= u.role %></span></td>
                <td>
                  <% if (u.id !== user.id) { %>
                    <form action="/admin/users/delete/<%= u.id %>" method="POST" onsubmit="return confirm('ยืนยันการลบ?');">
                      <button type="submit" class="btn btn-danger btn-sm">ลบ</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted">บัญชีปัจจุบัน</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>