<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>อัปโหลดไฟล์ SQL</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="m-0">อัปโหลดไฟล์ .sql</h5>
        <a href="/items" class="btn btn-sm btn-secondary">ย้อนกลับ</a>
      </div>
      <div class="card-body">
        <% if (message) { %>
          <div class="alert alert-info py-2"><%= message %></div>
        <% } %>
        <form action="/admin/upload" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label">เลือกไฟล์ SQL ตัวอย่าง (เช่น asdasd.sql)</label>
            <input type="file" name="sqlfile" class="form-control" accept=".sql" required>
          </div>
          <button type="submit" class="btn btn-success w-100">อ่านและบันทึกข้อมูล</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>